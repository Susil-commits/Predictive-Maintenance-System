# Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: If password contains special characters like '@', URL-encode them (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Server Settings
HOST=127.0.0.1
PORT=8000

# Administrative Security
# Required for DELETE /history and POST /retrain endpoints
PMS_API_KEY=pms-admin-secret-key

# ── Admin Portal Credentials (VITE_ prefix = included in JS bundle) ──────────
# These are app-level access controls. Change them to something unique.
VITE_ADMIN_USERNAME=your-admin-username
VITE_ADMIN_PASSWORD=your-admin-password

# ── Cloudinary — Backend only (NEVER use VITE_ prefix for the secret) ────────
# Used by FastAPI for server-side upload signing (optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ── Cloudinary — Frontend (unsigned upload preset — NO API secret here) ───────
# 1. Go to https://cloudinary.com/console → Settings → Upload → Upload presets
# 2. Create an unsigned preset named e.g. "pms_uploads"
# 3. Set allowed folders to: pms/avatars, pms/batch, pms/reports
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=pms_uploads
