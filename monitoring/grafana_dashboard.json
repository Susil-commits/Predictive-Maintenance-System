      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "title": "Request Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(pms_predictions_total[1m])",
          "legendFormat": "Prediction Rate (RPS)",
          "refId": "A"
        }
      ]
